df$age_at_death <- ifelse(df$age.at.death == "no death occurred",
                          NA,
                          df$age.at.death)

df$age.at.death <- as.numeric(df$age.at.death)

df$current.age.of.child <- as.numeric(df$current.age.of.child)
df$event <- ifelse(df$current.age.of.child == "no", 1, 0)
df$age.at.death <- ifelse(df$event == 1,
                  df$age.at.death,
                  df$current.age.of.child)

df$age.at.death <- ifelse(df$event == 1 & (is.na(df$age.at.death) | df$age.at.death == 0),
                  df$current.age.of.child,
                  df$age.at.death)

df <- df %>% filter(!is.na(df$age.at.death))

df$education.level <- as.factor(df$education.level)
df$weath.index <- as.factor(df$weath.index )
df$sex.of.child <- as.factor(df$sex.of.child)
