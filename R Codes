#OBJECTIVE 2: LOG-RANK TEST
survdiff(surv_obj ~ df$sex.of.child, data = df)
survdiff(surv_obj ~ df$weath.index, data = df)
survdiff(surv_obj ~ df$education.level, data = df)
survdiff(surv_obj ~ df$type.of.residence, data = df)

#OBJECTIVES 3 & 4: COX MODEL
cox_model <- coxph(surv_obj ~ 
                     df$sex.of.child+
                     df$education.level +
                     df$weath.index +
                     df$type.of.residence +
                     df$birth.order,
                   data = df)

summary(cox_model)

#HAZARD RATIOS
exp(coef(cox_model))
exp(confint(cox_model))

#PH ASSUMPTION
ph_test <- cox.zph(cox_model)
ph_test
plot(ph_test)


#FRAILTY MODEL
frailty_model <- coxph(surv_obj ~ 
                         df$sex.of.child +
                         df$education.level +
                         df$birth.order+
                         frailty(df$weath.index),
                       data = df)

summary(frailty_model)

#MODEL COMPARISON
AIC(cox_model)
AIC(frailty_model)

